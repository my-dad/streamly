<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
            foregroundServiceType and FOREGROUND_SERVICE_DATA_SYNC are both required from
            API 34: without either, promoting the service to the foreground throws
            MissingForegroundServiceTypeException and the first download kills the app.
            The emulator here is API 33, where both are ignored — so this cannot be
            proven locally and is written from the platform contract, not observation.
        -->
        <service
            android:name="io.github.mabrur.streamly.core.player.download.StreamlyDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
